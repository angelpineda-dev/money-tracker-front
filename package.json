{
    "name": "money-tracker-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "gen:api": "npx -y -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript api/openapi.yaml -o src/api/schema.d.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hookform/resolvers": "^7.0.2",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.5.0",
        "@mui/x-charts": "^9.17.0",
        "@mui/x-date-pickers": "^9.17.0",
        "@tanstack/react-query": "^5.105.3",
        "axios": "^1.21.0",
        "dayjs": "^1.11.23",
        "notistack": "^3.0.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-router": "^8.5.1",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@tanstack/react-query-devtools": "^5.105.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "jsdom": "^27.0.1",
        "msw": "^3.0.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
